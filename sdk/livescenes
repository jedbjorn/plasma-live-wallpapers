#!/usr/bin/env python3
"""livescenes: make, check, install and publish Live Scenes looks.

A look is a seamlessly looping video used as a wallpaper by the Live Scenes apps (Linux/Plasma, macOS,
Android). This tool turns any video (a Blender or After Effects render, AI video, phone footage, a screen
capture) into a look pack as described in sdk/FORMAT.md.

Needs Python 3.8+ and ffmpeg/ffprobe (with libx265) on PATH, or set $FFMPEG and $FFPROBE.
"""

import argparse
import hashlib
import json
import os
import platform
import re
import shutil
import statistics
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

FORMAT_VERSION = 1
FPS = 30
KEYINT = 60                      # frames: a keyframe at least every 2 s
SIZES = {"landscape": (2560, 1440), "portrait": (1080, 2400)}
POSTER_LONG = 640
ID_RE = re.compile(r"^[a-z0-9-]+$")
ANDROID_PACKAGE = "com.designsos.livescenes"
DEFAULT_CRF = 24
DEFAULT_PRESET = "slow"


# --------------------------------------------------------------------------------------------- helpers

class Fail(Exception):
    pass


def tool(name):
    env = os.environ.get(name.upper())
    if env:
        return env
    found = shutil.which(name)
    if not found:
        raise Fail(f"{name} not found: install ffmpeg (with libx265) or set ${name.upper()}")
    return found


def run(cmd, capture=False, check=True):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.PIPE if capture else None)
    except FileNotFoundError:
        raise Fail(f"cannot run {cmd[0]}")
    if check and p.returncode != 0:
        err = p.stderr.decode(errors="replace").strip() if capture and p.stderr else ""
        raise Fail(f"command failed ({p.returncode}): {' '.join(map(str, cmd))}" + (f"\n{err}" if err else ""))
    return p


def ffprobe_json(path, *extra):
    p = run([tool("ffprobe"), "-v", "error", "-print_format", "json", "-show_format", "-show_streams",
             *extra, str(path)], capture=True)
    return json.loads(p.stdout or b"{}")


def rate(s):
    """'30000/1001' -> 29.97"""
    try:
        n, _, d = str(s).partition("/")
        return float(n) / float(d or 1)
    except (ValueError, ZeroDivisionError):
        return 0.0


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def parse_point(s):
    try:
        x, y = (float(v) for v in s.split(","))
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected X,Y fractions like 0.5,0.4, got {s!r}")
    if not (0 <= x <= 1 and 0 <= y <= 1):
        raise argparse.ArgumentTypeError(f"X and Y must be between 0 and 1, got {s!r}")
    return (x, y)


def write_json(path, data):
    path = Path(path)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def human(n):
    return f"{n / 1e6:.1f} MB"


def info(msg):
    print(msg, flush=True)


def warn(msg):
    print(f"warning: {msg}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------------------------- themes

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
# Monet styles Android applies from the system theme setting (Android 17 on a Pixel takes these; CONTENT and
# FIDELITY fall back to TONAL_SPOT there)
STYLES = ("TONAL_SPOT", "VIBRANT", "EXPRESSIVE", "SPRITZ", "RAINBOW", "FRUIT_SALAD", "MONOCHROMATIC")


def rgb(hexcolor):
    v = int(hexcolor[1:], 16)
    return (v >> 16) & 255, (v >> 8) & 255, v & 255


def lab_chroma(hexcolor):
    """CIELAB chroma of an sRGB color: a stand-in for Material's HCT chroma (Monet ignores seeds below 5)."""
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(c) for c in rgb(hexcolor))
    x, y, z = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047, 0.2126 * r + 0.7152 * g + 0.0722 * b, \
        (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
    f = lambda t: t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116
    a, bb = 500 * (f(x) - f(y)), 200 * (f(y) - f(z))
    return (a * a + bb * bb) ** 0.5


def theme_problems(t):
    """What is wrong with a scene's theme (sdk/FORMAT.md), as a list of strings; empty if it is fine."""
    if not isinstance(t, dict):
        return ["theme must be an object"]
    out = []
    for k in ("primary", "secondary", "tertiary"):
        if k in t or k == "primary":
            if not (isinstance(t.get(k), str) and HEX_RE.match(t[k])):
                out.append(f"theme.{k} must be a color like #4f8a8b, got {t.get(k)!r}")
    if "dark" in t and not isinstance(t["dark"], bool):
        out.append("theme.dark must be true or false")
    if "style" in t and t["style"] not in STYLES:
        out.append(f"theme.style must be one of {', '.join(STYLES)}, got {t['style']!r}")
    return out


def parse_theme(value, light=False, style=None):
    """A theme from --theme: '#primary[,#secondary[,#tertiary]]', or a JSON file holding a theme (or a scene.json)."""
    if Path(value).is_file():
        data = json.loads(Path(value).read_text(encoding="utf-8"))
        t = dict(data.get("theme", data)) if isinstance(data, dict) else data
    else:
        colors = [c.strip() for c in value.split(",") if c.strip()]
        if not 1 <= len(colors) <= 3:
            raise Fail(f"--theme takes one to three colors (#rrggbb,...) or a JSON file, got {value!r}")
        t = dict(zip(("primary", "secondary", "tertiary"), colors))
        t["dark"] = True
    if light:
        t["dark"] = False
    if style:
        t["style"] = style.upper()
    for k in ("primary", "secondary", "tertiary"):
        if isinstance(t.get(k), str):
            t[k] = t[k].lower()
    problems = theme_problems(t)
    if problems:
        raise Fail("; ".join(problems))
    return t


def suggest_theme(poster):
    """A starting point for a look's theme from its poster: its most present vivid hues, made bright enough to read
    as accents. Only a suggestion: pick the final colors by eye (see the skill)."""
    w, h = 64, 36
    p = run([tool("ffmpeg"), "-v", "error", "-i", str(poster), "-vf", f"scale={w}:{h}:flags=area", "-f", "rawvideo",
             "-pix_fmt", "rgb24", "-"], capture=True)
    data = p.stdout
    import colorsys
    bins, lum = {}, 0.0
    for i in range(0, len(data) - 2, 3):
        r, g, b = data[i] / 255, data[i + 1] / 255, data[i + 2] / 255
        lum += 0.2126 * r + 0.7152 * g + 0.0722 * b
        hh, ss, vv = colorsys.rgb_to_hsv(r, g, b)
        if ss < 0.25 or vv < 0.12:
            continue
        k = int(hh * 24) % 24
        wt = ss * vv
        acc = bins.setdefault(k, [0.0, 0.0, 0.0, 0.0])
        acc[0] += wt
        acc[1] += r * wt
        acc[2] += g * wt
        acc[3] += b * wt
    dark = lum / (len(data) // 3) < 0.5
    picked = []
    for k, acc in sorted(bins.items(), key=lambda kv: -kv[1][0]):
        if acc[0] < 0.4 or any(min((k - q) % 24, (q - k) % 24) < 3 for q in picked):
            continue
        picked.append(k)
        if len(picked) == 3:
            break
    colors = []
    for k in picked:
        acc = bins[k]
        hh, ss, vv = colorsys.rgb_to_hsv(acc[1] / acc[0], acc[2] / acc[0], acc[3] / acc[0])
        r, g, b = colorsys.hsv_to_rgb(hh, max(ss, 0.55), max(vv, 0.75))
        colors.append("#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255)))
    if not colors:   # black and white: a cool grey that Monet still reads as a color, and a grey style
        return {"primary": "#8a94a6", "dark": dark, "style": "MONOCHROMATIC"}
    t = dict(zip(("primary", "secondary", "tertiary"), colors))
    t["dark"] = dark
    return t


def theme_line(t):
    colors = ",".join(t[k] for k in ("primary", "secondary", "tertiary") if k in t)
    return f"{colors}  {'dark' if t.get('dark', True) else 'light'}" + (f"  style {t['style']}" if "style" in t else "")


THEME_HOWTO = ("design it by eye (see skills/live-scene/SKILL.md), then: livescenes theme {pack} --set "
               "'#primary,#secondary,#tertiary' [--light] [--style STYLE]")


# --------------------------------------------------------------------------------------------- source probing

class Source:
    def __init__(self, path):
        self.path = Path(path)
        if not self.path.is_file():
            raise Fail(f"no such file: {path}")
        j = ffprobe_json(self.path)
        vs = [s for s in j.get("streams", []) if s.get("codec_type") == "video"
              and not s.get("disposition", {}).get("attached_pic")]
        if not vs:
            raise Fail(f"{path}: no video stream")
        v = vs[0]
        self.width, self.height = int(v["width"]), int(v["height"])
        rot = 0
        for sd in v.get("side_data_list", []):
            if "rotation" in sd:
                rot = int(float(sd["rotation"]))
        if "rotate" in v.get("tags", {}):
            rot = int(v["tags"]["rotate"])
        if abs(rot) % 180 == 90:                  # ffmpeg auto-rotates phone footage while decoding
            self.width, self.height = self.height, self.width
        self.fps = rate(v.get("avg_frame_rate")) or rate(v.get("r_frame_rate"))
        dur = v.get("duration") or j.get("format", {}).get("duration")
        self.duration = float(dur) if dur else 0.0
        self.transfer = v.get("color_transfer", "")
        self.hdr = self.transfer in ("smpte2084", "arib-std-b67")


# --------------------------------------------------------------------------------------------- pack

def crop_geometry(src_w, src_h, out_w, out_h, focus):
    """Scale to fill out_w x out_h, crop around focus. Returns (scaled_w, scaled_h, x, y, focus_in_output)."""
    s = max(out_w / src_w, out_h / src_h)
    sw, sh = max(out_w, round(src_w * s)), max(out_h, round(src_h * s))
    fx, fy = focus[0] * sw, focus[1] * sh
    x = int(round(min(max(fx - out_w / 2, 0), sw - out_w)))
    y = int(round(min(max(fy - out_h / 2, 0), sh - out_h)))
    out_focus = (round((fx - x) / out_w, 3), round((fy - y) / out_h, 3))
    return sw, sh, x, y, out_focus, (out_w * out_h) / (sw * sh), s


def loop_filter(start_frames, length_frames, fade_frames):
    """Filter chain (input [0:v]) that cuts [start, start+length+fade) at 30 fps and crossfades the extra
    tail into the head, so the result is `length` long and its last frame flows into its first."""
    L, F = length_frames, fade_frames
    head = f"[0:v]fps={FPS},trim=start_frame={start_frames}:end_frame={start_frames + L + F},setpts=PTS-STARTPTS"
    if F == 0:
        return head
    return (f"{head},split[a][b];"
            f"[a]trim=start_frame={F}:end_frame={L + F},setpts=PTS-STARTPTS[m];"
            f"[b]trim=end_frame={F},setpts=PTS-STARTPTS[h];"
            f"[m][h]xfade=transition=fade:duration={F / FPS:.6f}:offset={(L - F) / FPS:.6f}")


def tonemap_chain():
    # HDR (HLG/PQ, e.g. iPhone footage) to SDR BT.709
    return ("zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=hable:desat=0,"
            "zscale=t=bt709:m=bt709:r=tv")


ROTATIONS = {"cw": (90, "transpose=1"), "ccw": (-90, "transpose=2")}


def rotate_point(p, rotate):
    """A point (fractions) of the source, after rotating the picture 90 degrees cw or ccw."""
    if rotate == "cw":
        return (1 - p[1], p[0])
    if rotate == "ccw":
        return (p[1], 1 - p[0])
    return p


def encode(src, seek, start_frames, length_frames, fade_frames, out_w, out_h, focus, crf, preset, out_path, label,
           extra_x265="", rotate=None):
    src_w, src_h = (src.height, src.width) if rotate else (src.width, src.height)
    focus = rotate_point(focus, rotate)
    sw, sh, x, y, out_focus, kept, scale = crop_geometry(src_w, src_h, out_w, out_h, focus)
    if kept < 0.5:
        warn(f"{label}: cropping {src_w}x{src_h} to {out_w}x{out_h} keeps only {kept:.0%} of the picture")
    if scale > 1.05:
        warn(f"{label}: upscaling {src_w}x{src_h} by {scale:.2f}x; a larger source would look sharper")
    chain = loop_filter(start_frames, length_frames, fade_frames)
    if src.hdr:
        info(f"{label}: HDR source ({src.transfer}), tone-mapping to SDR")
        chain += "," + tonemap_chain()
    if rotate:
        chain += "," + ROTATIONS[rotate][1]
    chain += (f",scale={sw}:{sh}:flags=lanczos+accurate_rnd+full_chroma_int,crop={out_w}:{out_h}:{x}:{y},setsar=1,"
              f"scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[out]")
    x265 = (f"keyint={KEYINT}:min-keyint={FPS}:open-gop=0:aq-mode=3:log-level=error:"
            "colorprim=bt709:transfer=bt709:colormatrix=bt709:range=limited")
    if extra_x265:                       # ours come last so keyframe settings can't be overridden
        x265 = extra_x265 + ":" + x265
    cmd = [tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-stats", "-y",
           "-ss", f"{seek:.3f}", "-t", f"{(length_frames + fade_frames) / FPS + 1:.3f}", "-i", str(src.path),
           "-filter_complex", chain, "-map", "[out]", "-an", "-sn", "-dn", "-map_metadata", "-1",
           "-c:v", "libx265", "-preset", preset, "-crf", str(crf), "-profile:v", "main", "-pix_fmt", "yuv420p",
           "-x265-params", x265, "-tag:v", "hvc1",
           "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709", "-color_range", "tv",
           "-r", str(FPS), "-fps_mode", "cfr", "-movflags", "+faststart", str(out_path)]
    info(f"{label}: {src.path.name}{f' rotated {rotate}' if rotate else ''} -> {out_path.name} {out_w}x{out_h}, "
         f"crf {crf}, preset {preset}")
    run(cmd)
    frames = count_frames(out_path)
    if frames != length_frames:
        raise Fail(f"{label}: got {frames} frames, expected {length_frames}: is the source long enough "
                   f"for --start + --length + --fade?")
    return out_focus


def count_frames(path):
    p = run([tool("ffprobe"), "-v", "error", "-select_streams", "v:0", "-count_packets",
             "-show_entries", "stream=nb_read_packets", "-of", "csv=p=0", str(path)], capture=True)
    return int(p.stdout.decode().strip().split(",")[0] or 0)


def cmd_pack(a):
    if not ID_RE.match(a.id):
        raise Fail(f"--id must match [a-z0-9-]+, got {a.id!r}")
    if a.no_landscape and a.no_portrait:
        raise Fail("--no-landscape and --no-portrait together leave nothing to make")
    if a.fade < 0:
        raise Fail("--fade must be >= 0")
    if a.portrait_rotate and a.portrait:
        raise Fail("--portrait-rotate makes the portrait video from SRC; it cannot be combined with --portrait")
    if a.portrait_rotate and a.no_portrait:
        raise Fail("--portrait-rotate and --no-portrait contradict each other")
    out = Path(a.output)
    if out.name != a.id:
        warn(f"the pack folder should be named after its id ({a.id}), not {out.name}")
    theme = parse_theme(a.theme, a.theme_light, a.theme_style) if a.theme else None
    if theme is None and (out / "scene.json").is_file():   # re-packing: keep the theme designed for it
        try:
            old = json.loads((out / "scene.json").read_text(encoding="utf-8")).get("theme")
        except ValueError:
            old = None
        if old and not theme_problems(old):
            theme = old
            info(f"keeping the theme of {out}/scene.json: {theme_line(theme)}")
    src = Source(a.src)
    psrc = Source(a.portrait) if a.portrait else None

    start = a.start
    usable = src.duration - start - a.fade
    if psrc:
        usable = min(usable, psrc.duration - start - a.fade)
    length = a.length if a.length else usable
    if length <= 0 or (src.duration and start + length + a.fade > src.duration + 0.5 / FPS):
        raise Fail(f"source is {src.duration:.2f} s; --start {start} + --length {length:.2f} + --fade {a.fade} "
                   f"does not fit (the fade needs that much extra footage after the loop)")
    L, F = round(length * FPS), round(a.fade * FPS)
    if F > L // 2:
        raise Fail("--fade must be at most half of --length")
    if L < FPS:
        raise Fail("--length must be at least 1 s")
    if abs(src.fps - FPS) > 0.01:
        warn(f"source is {src.fps:.3f} fps; frames are resampled to {FPS} fps")
    seek = start
    out.mkdir(parents=True, exist_ok=True)

    videos = {}
    if not a.no_landscape:
        w, h = SIZES["landscape"]
        foc = encode(src, seek, 0, L, F, w, h, a.focus, a.crf, a.preset, out / "landscape.mp4", "landscape",
                     a.x265)
        videos["landscape"] = foc
    if not a.no_portrait:
        w, h = SIZES["portrait"]
        if psrc:
            foc = encode(psrc, seek, 0, L, F, w, h, a.portrait_focus or (0.5, 0.5), a.portrait_crf or a.crf,
                         a.preset, out / "portrait.mp4", "portrait", a.x265)
        else:
            foc = encode(src, seek, 0, L, F, w, h, a.portrait_focus or a.focus, a.portrait_crf or a.crf,
                         a.preset, out / "portrait.mp4", "portrait", a.x265, a.portrait_rotate)
        videos["portrait"] = foc
    for stale in ("landscape", "portrait"):
        if stale not in videos and (out / f"{stale}.mp4").exists():
            (out / f"{stale}.mp4").unlink()

    poster_src = out / ("landscape.mp4" if "landscape" in videos else "portrait.mp4")
    pt = min(max(a.poster_time, 0), (L - 1) / FPS)
    run([tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-y", "-ss", f"{pt:.3f}", "-i", str(poster_src),
         "-frames:v", "1", "-vf", f"scale='if(gte(iw,ih),{POSTER_LONG},-2)':'if(gte(iw,ih),-2,{POSTER_LONG})'"
         ":flags=lanczos", "-q:v", "3", str(out / "poster.jpg")])

    scene = {"format": FORMAT_VERSION, "id": a.id, "title": a.title}
    for k in ("author", "license", "description"):
        if getattr(a, k):
            scene[k] = getattr(a, k)
    scene["loop"] = round(L / FPS, 3)
    scene["videos"] = {}
    for orient, foc in videos.items():
        f = out / f"{orient}.mp4"
        w, h = SIZES[orient]
        scene["videos"][orient] = {"file": f.name, "width": w, "height": h, "fps": FPS,
                                   "bytes": f.stat().st_size, "sha256": sha256(f), "focus": list(foc)}
        if orient == "portrait" and a.portrait_rotate:
            scene["videos"][orient]["rotate"] = ROTATIONS[a.portrait_rotate][0]
    if theme:
        scene["theme"] = theme
    write_json(out / "scene.json", scene)
    info(f"\npack written: {out}/  (loop {scene['loop']} s)")
    for orient, v in scene["videos"].items():
        info(f"  {v['file']:<14} {v['width']}x{v['height']}  {human(v['bytes'])}  focus {v['focus']}")
    info("  poster.jpg")
    if theme:
        info(f"  theme {theme_line(theme)}")
    else:
        warn(f"no Android theme yet. A start from the poster: {theme_line(suggest_theme(out / 'poster.jpg'))}\n  "
             + THEME_HOWTO.format(pack=out))
    info(f"next: livescenes check {out}")


# --------------------------------------------------------------------------------------------- check

class Checker:
    def __init__(self):
        self.failed = 0
        self.warned = 0

    def ok(self, cond, msg, detail=""):
        print(f"{'PASS' if cond else 'FAIL'}  {msg}{('  (' + detail + ')') if detail else ''}", flush=True)
        if not cond:
            self.failed += 1
        return cond

    def warn(self, msg):
        print(f"WARN  {msg}", flush=True)
        self.warned += 1


def mp4_top_boxes(path):
    boxes = []
    with open(path, "rb") as f:
        size_total = os.fstat(f.fileno()).st_size
        pos = 0
        while pos + 8 <= size_total:
            f.seek(pos)
            hdr = f.read(8)
            size, typ = struct.unpack(">I4s", hdr)
            if size == 1:
                size = struct.unpack(">Q", f.read(8))[0]
            elif size == 0:
                size = size_total - pos
            if size < 8:
                break
            boxes.append(typ.decode("latin-1"))
            pos += size
    return boxes


def gray_frames(path, w, h, extra_in=(), extra_out=()):
    """Decode a stretch of video as small grayscale frames (list of bytes)."""
    cmd = [tool("ffmpeg"), "-hide_banner", "-loglevel", "error", *extra_in, "-i", str(path), *extra_out,
           "-vf", f"scale={w}:{h}:flags=area,format=gray", "-f", "rawvideo", "-"]
    data = run(cmd, capture=True).stdout
    n = w * h
    return [data[i:i + n] for i in range(0, len(data) - n + 1, n)]


def mad(a, b):
    return sum(map(abs, map(int.__sub__, a, b))) / len(a)


def seam_check(c, path, label, vw, vh, key_frames):
    """The jump from the last frame to the first must look like an ordinary frame change. The first frame is
    always a keyframe, and keyframes change a little more than other frames (fresh compression), so the jump
    is compared with ordinary changes near the seam and with the changes into the video's other keyframes."""
    long_side = 192
    w, h = (long_side, max(2, round(long_side * vh / vw / 2) * 2)) if vw >= vh else \
        (max(2, round(long_side * vw / vh / 2) * 2), long_side)
    fr = gray_frames(path, w, h)
    if len(fr) < 4:
        c.ok(False, f"{label}: loop seam", "could not decode frames")
        return
    near = min(len(fr) // 2, 4 * FPS)                  # 4 s on each side of the seam
    local = [mad(x, y) for x, y in zip(fr[:near], fr[1:near])] + \
            [mad(x, y) for x, y in zip(fr[-near:], fr[-near + 1:])]
    keyed = sorted(mad(fr[k - 1], fr[k]) for k in key_frames if 0 < k < len(fr))
    seam = mad(fr[-1], fr[0])
    med = statistics.median(local)
    p95 = sorted(local)[int(0.95 * (len(local) - 1))]
    kf = 1.5 * keyed[int(0.9 * (len(keyed) - 1))] if keyed else 0.0
    limit = max(2.0 * med, p95, kf, 0.3)
    c.ok(seam <= limit, f"{label}: loop seam is smooth",
         f"last->first change {seam:.2f}; near the seam: typical {med:.2f}, 95th pct {p95:.2f}; "
         f"into keyframes: {kf / 1.5 if keyed else 0:.2f} (90th pct); limit {limit:.2f}")


def check_video(c, pack, orient, v, loop):
    label = orient
    f = pack / str(v.get("file", ""))
    if not c.ok(f.is_file(), f"{label}: file {v.get('file')} exists"):
        return
    size = f.stat().st_size
    c.ok(size == v.get("bytes"), f"{label}: bytes match", f"{size} on disk, {v.get('bytes')} in scene.json")
    digest = sha256(f)
    c.ok(digest == v.get("sha256"), f"{label}: sha256 matches")
    j = ffprobe_json(f)
    streams = j.get("streams", [])
    vs = [s for s in streams if s.get("codec_type") == "video"]
    others = [s.get("codec_type") for s in streams if s.get("codec_type") != "video"]
    c.ok(len(vs) == 1, f"{label}: one video stream", f"{len(vs)} found")
    c.ok(not others, f"{label}: no audio or other streams", ", ".join(others) if others else "")
    if not vs:
        return
    s = vs[0]
    c.ok(s.get("codec_name") == "hevc", f"{label}: codec HEVC", s.get("codec_name", "?"))
    c.ok(s.get("profile") == "Main", f"{label}: profile Main", s.get("profile", "?"))
    c.ok(s.get("pix_fmt") == "yuv420p", f"{label}: pix_fmt yuv420p (8-bit)", s.get("pix_fmt", "?"))
    c.ok(s.get("codec_tag_string") == "hvc1", f"{label}: tag hvc1", s.get("codec_tag_string", "?"))
    tags = [s.get(k, "unknown") for k in ("color_space", "color_primaries", "color_transfer")]
    if tags != ["bt709"] * 3 or s.get("color_range") != "tv":
        c.warn(f"{label}: colour is not tagged BT.709 limited range ({', '.join(tags)}, {s.get('color_range')}); "
               "players will guess")
    c.ok(j.get("format", {}).get("format_name", "").startswith("mov,mp4"), f"{label}: MP4 container")
    w, h = int(s.get("width", 0)), int(s.get("height", 0))
    c.ok((w, h) == (v.get("width"), v.get("height")), f"{label}: size {w}x{h} matches scene.json",
         f"scene.json says {v.get('width')}x{v.get('height')}")
    c.ok((w >= h) if orient == "landscape" else (h > w), f"{label}: orientation fits")
    if (w, h) != SIZES[orient]:
        c.warn(f"{label}: {w}x{h} is not the usual {SIZES[orient][0]}x{SIZES[orient][1]}")
    r, avg = rate(s.get("r_frame_rate")), rate(s.get("avg_frame_rate"))
    c.ok(abs(r - FPS) < 0.01 and abs(avg - FPS) < 0.01, f"{label}: constant {FPS} fps",
         f"r_frame_rate {s.get('r_frame_rate')}, avg {s.get('avg_frame_rate')}")
    c.ok(v.get("fps") == FPS, f"{label}: scene.json fps is {FPS}", str(v.get("fps")))
    # packets: count, keyframe spacing
    p = run([tool("ffprobe"), "-v", "error", "-select_streams", "v:0", "-show_entries", "packet=pts_time,flags",
             "-of", "csv=p=0", str(f)], capture=True)
    pk = []
    for line in p.stdout.decode().split():
        t, _, fl = line.partition(",")
        try:
            pk.append((float(t), "K" in fl))
        except ValueError:
            pass
    pk.sort()
    n = len(pk)
    dur = n / FPS
    if isinstance(loop, (int, float)):
        c.ok(abs(dur - loop) <= 1.0 / FPS + 1e-6, f"{label}: duration matches loop",
             f"{n} frames = {dur:.3f} s, loop {loop}")
    keys = [t for t, k in pk if k]
    if keys and pk:
        gaps = [b - a for a, b in zip(keys, keys[1:])] + [pk[-1][0] + 1 / FPS - keys[-1]]
        c.ok(keys[0] == pk[0][0] and max(gaps) <= 2.0 + 1e-6, f"{label}: keyframe at least every 2 s",
             f"{len(keys)} keyframes, longest gap {max(gaps):.2f} s")
    else:
        c.ok(False, f"{label}: keyframes", "none found")
    boxes = mp4_top_boxes(f)
    c.ok("moov" in boxes and "mdat" in boxes and boxes.index("moov") < boxes.index("mdat"),
         f"{label}: faststart (moov before mdat)", " ".join(boxes))
    if "rotate" in v:
        c.ok(v["rotate"] in (90, -90), f"{label}: rotate is 90 or -90", str(v["rotate"]))
    focus = v.get("focus", [0.5, 0.5])
    c.ok(isinstance(focus, list) and len(focus) == 2 and all(isinstance(x, (int, float)) and 0 <= x <= 1
                                                             for x in focus), f"{label}: focus", str(focus))
    seam_check(c, f, label, w, h, [round(t * FPS) for t in keys])


def cmd_check(a):
    pack = Path(a.packdir)
    c = Checker()
    sj = pack / "scene.json"
    if not c.ok(sj.is_file(), "scene.json exists"):
        return 1
    try:
        scene = json.loads(sj.read_text(encoding="utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        c.ok(False, "scene.json is valid JSON", str(e))
        return 1
    c.ok(isinstance(scene, dict), "scene.json is an object")
    if not isinstance(scene, dict):
        return 1
    c.ok(scene.get("format") == FORMAT_VERSION, f"format is {FORMAT_VERSION}", str(scene.get("format")))
    sid = scene.get("id")
    c.ok(isinstance(sid, str) and bool(ID_RE.match(sid)), "id matches [a-z0-9-]+", repr(sid))
    if isinstance(sid, str) and pack.resolve().name != sid:
        c.warn(f"folder is named {pack.resolve().name!r}, not after the id {sid!r}")
    c.ok(isinstance(scene.get("title"), str) and scene["title"].strip() != "", "title is set")
    for k in ("author", "license", "description"):
        if k in scene:
            c.ok(isinstance(scene[k], str), f"{k} is a string")
        elif k != "description":
            c.warn(f"no {k}")
    loop = scene.get("loop")
    c.ok(isinstance(loop, (int, float)) and loop > 0, "loop is a positive number of seconds", str(loop))
    videos = scene.get("videos")
    if not c.ok(isinstance(videos, dict) and videos and set(videos) <= {"landscape", "portrait"},
                "videos has landscape and/or portrait", str(list(videos) if isinstance(videos, dict) else videos)):
        return 1
    for orient in ("landscape", "portrait"):
        if orient in videos:
            v = videos[orient]
            if c.ok(isinstance(v, dict) and all(k in v for k in ("file", "width", "height", "fps", "bytes", "sha256")),
                    f"{orient}: has file, width, height, fps, bytes, sha256"):
                check_video(c, pack, orient, v, loop)
    if "theme" in scene:
        problems = theme_problems(scene["theme"])
        if c.ok(not problems, "theme is valid", "; ".join(problems)):
            t = scene["theme"]
            if lab_chroma(t["primary"]) < 8:
                c.warn(f"theme.primary {t['primary']} is nearly grey: Android ignores seeds without color and falls "
                       "back to blue (give it a hint of hue, and style MONOCHROMATIC for a grey look)")
    else:
        c.ok(False, "theme is set (every look ships an Android theme)", THEME_HOWTO.format(pack=pack))
    poster = pack / "poster.jpg"
    if c.ok(poster.is_file(), "poster.jpg exists"):
        j = ffprobe_json(poster)
        s = (j.get("streams") or [{}])[0]
        pw, ph = int(s.get("width", 0)), int(s.get("height", 0))
        c.ok(max(pw, ph) == POSTER_LONG, f"poster is {POSTER_LONG} px on the long side", f"{pw}x{ph}")
        c.ok(s.get("codec_name") == "mjpeg", "poster is a JPEG", s.get("codec_name", "?"))
    print(f"\n{'FAILED' if c.failed else 'OK'}: {c.failed} failed, {c.warned} warnings")
    return 1 if c.failed else 0


# --------------------------------------------------------------------------------------------- add

def load_scene(pack):
    sj = Path(pack) / "scene.json"
    if not sj.is_file():
        raise Fail(f"{pack}: no scene.json (make one with `livescenes pack`)")
    scene = json.loads(sj.read_text(encoding="utf-8"))
    if not isinstance(scene, dict) or not ID_RE.match(str(scene.get("id", ""))) or not scene.get("videos"):
        raise Fail(f"{sj}: not a valid scene.json (run `livescenes check {pack}`)")
    return scene


def data_dir():
    system = platform.system()
    if system == "Darwin":
        return Path.home() / "Library" / "Application Support" / "LiveScenes"
    if system == "Linux":
        return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "live-scenes"
    raise Fail(f"`add` supports Linux and macOS (and Android with --android), not {system}")


def find_adb():
    env = os.environ.get("ADB")
    if env:
        found = shutil.which(env)
        if not found:
            raise Fail(f"$ADB is set to {env!r}, which is not an executable")
        return found
    cands = [shutil.which("adb")]
    for env in ("ANDROID_HOME", "ANDROID_SDK_ROOT"):
        if os.environ.get(env):
            cands.append(str(Path(os.environ[env]) / "platform-tools" / "adb"))
    cands.append(str(Path.home() / "Android" / "Sdk" / "platform-tools" / "adb"))
    cands.append(str(Path.home() / "Library" / "Android" / "sdk" / "platform-tools" / "adb"))
    for c in cands:
        if c and Path(c).is_file() and os.access(c, os.X_OK):
            return c
    raise Fail("adb not found: install Android platform-tools or set $ADB")


def add_android(pack, scene):
    adb = find_adb()
    sid = scene["id"]
    p = run([adb, "get-state"], capture=True, check=False)
    if p.returncode != 0:
        raise Fail("no Android device: connect one with USB debugging on (adb devices)")
    p = run([adb, "shell", "pm", "path", ANDROID_PACKAGE], capture=True, check=False)
    if not p.stdout.strip():
        warn(f"{ANDROID_PACKAGE} does not seem to be installed on the device")
    dest = f"/sdcard/Android/data/{ANDROID_PACKAGE}/files/import/{sid}"
    run([adb, "shell", "mkdir", "-p", dest])
    files = [f for f in ("landscape.mp4", "portrait.mp4", "poster.jpg") if (pack / f).is_file()] + ["scene.json"]
    for f in files:                                   # scene.json last: the pack is complete once it appears
        info(f"push {f}")
        run([adb, "push", str(pack / f), f"{dest}/{f}"])
    # adb pushes as the shell user (dir mode 2770); without this the app cannot read or remove the files
    run([adb, "shell", "chmod", "-R", "a+rwX", dest])
    info(f"\npushed to {dest}/\nOpen Live Scenes on the device to import it.")


def cmd_add(a):
    pack = Path(a.packdir)
    scene = load_scene(pack)
    sid = scene["id"]
    if a.android:
        return add_android(pack, scene)
    videos = scene["videos"]
    orient = "landscape" if "landscape" in videos else "portrait"
    if orient != "landscape":
        warn("the pack has no landscape video; installing the portrait one (it will be cropped)")
    v = videos[orient]
    src = pack / v["file"]
    if not src.is_file():
        raise Fail(f"missing {src}")
    if src.stat().st_size != v.get("bytes") or sha256(src) != v.get("sha256"):
        raise Fail(f"{src} does not match scene.json (bytes/sha256); re-run `livescenes pack`")

    root = data_dir()
    look = root / "looks" / sid
    look.mkdir(parents=True, exist_ok=True)
    tmp = look / f".{orient}.mp4.part"
    shutil.copyfile(src, tmp)
    os.replace(tmp, look / f"{orient}.mp4")
    for other in ("landscape.mp4", "portrait.mp4"):
        if other != f"{orient}.mp4" and (look / other).exists():
            (look / other).unlink()
    if (pack / "poster.jpg").is_file():
        shutil.copyfile(pack / "poster.jpg", look / "poster.jpg")
    saved = dict(scene)
    saved["videos"] = {orient: v}                     # only the file that is on this device
    write_json(look / "scene.json", saved)

    pf = root / "profiles.json"
    data = {"format": FORMAT_VERSION, "active": None, "profiles": []}
    if pf.is_file():
        try:
            data = json.loads(pf.read_text(encoding="utf-8"))
        except ValueError:
            raise Fail(f"{pf} is not valid JSON; fix or remove it")
        data.setdefault("format", FORMAT_VERSION)
        data.setdefault("profiles", [])
    profiles = data["profiles"]
    prof = next((p for p in profiles if p.get("look") == sid), None)
    if prof:
        info(f"profile {prof.get('id')!r} already uses look {sid!r}; files updated")
    else:
        ids = {p.get("id") for p in profiles}
        pid, n = sid, 2
        while pid in ids:
            pid, n = f"{sid}-{n}", n + 1
        prof = {"id": pid, "name": scene.get("title") or sid, "look": sid, "speed": 1.0}
        profiles.append(prof)
        info(f"added profile {pid!r}")
    if not data.get("active") or data["active"] not in {p.get("id") for p in profiles}:
        data["active"] = prof["id"]
        info(f"active profile: {prof['id']!r}")
    write_json(pf, data)
    info(f"installed {sid} ({orient}) in {look}/")


