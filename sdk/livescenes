def cmd_theme(a):
    pack = Path(a.packdir)
    scene = load_scene(pack)
    if a.set:
        scene["theme"] = parse_theme(a.set, a.light, a.style)
        write_json(pack / "scene.json", scene)
        info(f"{scene['id']}: theme {theme_line(scene['theme'])}")
        return 0
    if a.light or a.style:
        raise Fail("--light and --style go with --set")
    if scene.get("theme"):
        info(f"{scene['id']}: theme {theme_line(scene['theme'])}")
        problems = theme_problems(scene["theme"])
        for problem in problems:
            warn(problem)
        return 1 if problems else 0
    poster = pack / "poster.jpg"
    if not poster.is_file():
        raise Fail(f"{pack}: no theme and no poster.jpg to suggest one from")
    info(f"{scene['id']}: no theme yet. A start from the poster: {theme_line(suggest_theme(poster))}\n"
         + THEME_HOWTO.format(pack=pack))
    return 1


