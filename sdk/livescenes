def cmd_catalog(a):
    rel = Path(a.output)
    rel.mkdir(parents=True, exist_ok=True)
    cat_path = rel / "catalog.json"
    looks = []
    if a.append and cat_path.is_file():
        looks = json.loads(cat_path.read_text(encoding="utf-8")).get("looks", [])
    for pack in map(Path, a.packdirs):
        scene = load_scene(pack)
        sid = scene["id"]
        entry = {"id": sid, "title": scene.get("title", sid)}
        for k in ("author", "license", "description"):
            if k in scene:
                entry[k] = scene[k]
        entry["loop"] = scene.get("loop")
        if scene.get("theme") and not theme_problems(scene["theme"]):
            entry["theme"] = scene["theme"]
        else:
            warn(f"{sid}: NO ANDROID THEME. Phones fall back to the poster's colors. " + THEME_HOWTO.format(pack=pack))
        if (pack / "poster.jpg").is_file():
            copy_asset(pack / "poster.jpg", rel / f"{sid}-poster.jpg")
            entry["poster"] = f"{sid}-poster.jpg"
        entry["videos"] = {}
        for orient in ("landscape", "portrait"):
            v = scene["videos"].get(orient)
            if not v:
                continue
            src = pack / v["file"]
            name = f"{sid}-{orient}.mp4"
            copy_asset(src, rel / name)
            digest = sha256(rel / name)
            if digest != v.get("sha256"):
                raise Fail(f"{src}: sha256 does not match scene.json; run `livescenes check {pack}`")
            entry["videos"][orient] = {"url": name, "width": v["width"], "height": v["height"],
                                       "bytes": (rel / name).stat().st_size, "sha256": digest,
                                       "focus": v.get("focus", [0.5, 0.5])}
            if "rotate" in v:
                entry["videos"][orient]["rotate"] = v["rotate"]
        looks = [l for l in looks if l.get("id") != sid] + [entry]
        info(f"{sid}: " + ", ".join(f"{o} {human(e['bytes'])}" for o, e in entry["videos"].items()))
    write_json(cat_path, {"format": FORMAT_VERSION, "looks": looks})
    info(f"\nwrote {cat_path} ({len(looks)} looks). Upload everything in {rel}/ as release assets.")


def copy_asset(src, dst):
    if dst.exists() and dst.stat().st_size == src.stat().st_size and sha256(dst) == sha256(src):
        return
    shutil.copyfile(src, dst)


