HELP = __doc__ + """
typical session:
  livescenes pack render.mov -o packs/aurora --id aurora --title "Aurora" --author "Me" --license CC-BY-4.0
  livescenes check packs/aurora          # fails until the look has its Android theme:
  livescenes theme packs/aurora --set '#5b8def,#f2c14e,#e85d75'
  livescenes add packs/aurora            # this desktop
  livescenes add packs/aurora --android  # a phone over adb
  livescenes catalog packs/* -o release/

Run `livescenes <command> --help` for details.
"""

PACK_HELP = """Make a look pack: a folder with landscape.mp4 (2560x1440), portrait.mp4 (1080x2400), poster.jpg
and scene.json, as described in sdk/FORMAT.md.

The loop: the video is cut from --start, --length seconds long. To make it seamless, the pack uses
--fade more seconds of footage after the loop and crossfades them into its start, so the source must be
at least start + length + fade long. Render or record a little longer than the loop you want. If your
source already loops perfectly (e.g. a cyclic Blender render), use --fade 0.

Sizes: each video is scaled to fill its frame and cropped around the focus point. Without --portrait,
the portrait video is cropped out of SRC (a narrow vertical slice of a landscape source), so give a
--portrait-focus on what matters, supply a separately rendered portrait version with --portrait, or use
--portrait-rotate to turn the whole landscape picture sideways for phones.
Footage is resampled to 30 fps, encoded as HEVC (H.265) Main 8-bit, and HDR footage is tone-mapped to SDR.

The focus point is also stored in scene.json so players cropping the video for other screen shapes
keep it in view."""

PACK_EPILOG = """examples:
  # 20 s phone clip, use 15 s of it, crossfade 2 s, keep the subject (left third) in the portrait crop
  livescenes pack clip.mp4 -o packs/harbour --id harbour --title Harbour --length 15 --fade 2 \\
      --portrait-focus 0.33,0.5

  # Blender renders of the same animation in both orientations, already seamless
  livescenes pack wide.mkv --portrait tall.mkv --fade 0 -o packs/orbit --id orbit --title Orbit

  # landscape illustration: on phones show all of it turned sideways (upright with the phone's top to the left)
  livescenes pack art.mkv --portrait-rotate cw -o packs/poster --id poster --title Poster

  # desktop only
  livescenes pack ae-export.mov --no-portrait -o packs/grid --id grid --title Grid"""


def build_parser():
    ap = argparse.ArgumentParser(prog="livescenes", description=HELP,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", metavar="command", title="commands")

    p = sub.add_parser("pack", help="make a look pack (videos, poster, scene.json) from a video", description=PACK_HELP, epilog=PACK_EPILOG,
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("src", metavar="SRC", help="source video (any format ffmpeg reads)")
    p.add_argument("-o", "--output", metavar="OUTDIR", required=True,
                   help="pack folder to write; name it after the id (e.g. packs/aurora)")
    p.add_argument("--id", required=True, help="look id: lowercase letters, digits and dashes, e.g. aurora")
    p.add_argument("--title", required=True, help="name shown in the apps")
    p.add_argument("--author", help="who made it (shown as credit)")
    p.add_argument("--license", help="licence of the video, e.g. CC-BY-4.0, MIT, 'All rights reserved'")
    p.add_argument("--description", help="one sentence about the look")
    p.add_argument("--portrait", metavar="SRC2",
                   help="separate portrait source (same timing as SRC); default: crop the portrait from SRC")
    p.add_argument("--start", type=float, default=0.0, metavar="S", help="where the loop starts in the source, "
                   "in seconds (default 0)")
    p.add_argument("--length", type=float, metavar="S", help="loop length in seconds (default: all the footage "
                   "after --start minus --fade)")
    p.add_argument("--fade", type=float, default=1.5, metavar="S",
                   help="crossfade that makes the loop seamless, in seconds (default 1.5; 0 = SRC already loops)")
    p.add_argument("--focus", type=parse_point, default=(0.5, 0.5), metavar="X,Y",
                   help="point of interest in SRC as fractions of its width and height (0..1, default 0.5,0.5); "
                        "crops keep it in view")
    p.add_argument("--portrait-focus", type=parse_point, metavar="X,Y",
                   help="point of interest for the portrait video, in its source (SRC2, or SRC when the portrait "
                        "is made from it); default: --focus (0.5,0.5 with --portrait)")
    p.add_argument("--portrait-rotate", choices=("cw", "ccw"),
                   help="make the portrait video from SRC turned 90 degrees clockwise (cw) or counter-clockwise "
                        "(ccw) instead of cropping a slice of it: the whole landscape composition fills the phone "
                        "and reads upright when the phone is turned sideways. --portrait-focus is still given in "
                        "SRC's own (unrotated) coordinates. Recorded as \"rotate\": 90 or -90 in scene.json")
    p.add_argument("--no-portrait", action="store_true", help="make only the landscape video")
    p.add_argument("--no-landscape", action="store_true", help="make only the portrait video")
    p.add_argument("--crf", type=int, default=DEFAULT_CRF, metavar="N",
                   help=f"x265 quality, lower = better and bigger (default {DEFAULT_CRF}; 20-28 is sensible; "
                        "grain and noise need more bits)")
    p.add_argument("--portrait-crf", type=int, metavar="N", help="quality for the portrait video (default: --crf)")
    p.add_argument("--preset", default=DEFAULT_PRESET,
                   help=f"x265 preset: slower = smaller at the same quality (default {DEFAULT_PRESET})")
    p.add_argument("--x265", metavar="PARAMS", default="",
                   help="extra x265 parameters, e.g. aq-strength=1.3:psy-rd=2 (keyframe and GOP settings are fixed)")
    p.add_argument("--poster-time", type=float, default=0.0, metavar="S",
                   help="moment of the loop used for poster.jpg, in seconds (default 0)")
    p.add_argument("--theme", metavar="COLORS|FILE",
                   help="the look's Android theme: '#primary,#secondary,#tertiary' (primary seeds the phone's "
                        "Material You colors), or a JSON file with a theme. Default: the theme already in "
                        "OUTDIR/scene.json; without one, a suggestion from the poster is printed")
    p.add_argument("--theme-light", action="store_true",
                   help="with --theme: the look is light (dark text suits it); looks are dark by default")
    p.add_argument("--theme-style", choices=STYLES, metavar="STYLE",
                   help="with --theme: the Material You style that suits the look (" + ", ".join(STYLES) + ")")

    p = sub.add_parser("check", help="validate a look pack: format, encoding, checksums, loop seam",
                       description="Validate a look pack against sdk/FORMAT.md: scene.json fields, video codec, "
                       "profile, pixel format, hvc1 tag, 30 fps CFR, duration = loop, keyframe spacing, "
                       "faststart, no audio, sizes and checksums, and that the loop seam (last frame -> first "
                       "frame) is no bigger a change than the motion around it. Prints PASS/FAIL lines and "
                       "exits non-zero if anything fails.")
    p.add_argument("packdir", metavar="PACKDIR")

    p = sub.add_parser("theme", help="show, suggest or set a pack's Android theme (no re-encoding)",
                       description="Every look ships an Android theme: colors chosen by hand so the phone's Material "
                       "You theme matches the look (sdk/FORMAT.md). Without --set: shows the pack's theme, or a "
                       "suggestion from its poster. With --set: writes the theme into scene.json (the videos and "
                       "the poster are not touched). The first color seeds the palette; Android makes tones of it, "
                       "so it is the hue that counts.",
                       epilog="examples:\n  livescenes theme packs/embers\n"
                       "  livescenes theme packs/embers --set '#c0174a,#5e1a5c,#ff7a30'\n"
                       "  livescenes theme packs/sketch --set '#8a94a6,#d7d2c4' --style MONOCHROMATIC\n"
                       "  livescenes theme packs/hall --set scenes-src/hall/theme.json",
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("packdir", metavar="PACKDIR")
    p.add_argument("--set", metavar="COLORS|FILE",
                   help="'#primary[,#secondary[,#tertiary]]', or a JSON file with a theme (or a scene.json)")
    p.add_argument("--light", action="store_true", help="the look is light (dark text suits it)")
    p.add_argument("--style", choices=STYLES, metavar="STYLE", help="Material You style: " + ", ".join(STYLES))

    p = sub.add_parser("add", help="install a pack here, or push it to an Android phone",
                       description="Install a look pack on this computer: its landscape video, poster and "
                       "scene.json go to the Live Scenes saved-data folder (~/.local/share/live-scenes/ on Linux, "
                       "~/Library/Application Support/LiveScenes/ on macOS) and a profile for it is added to "
                       "profiles.json. The active profile only changes if there is none.\n\n"
                       "With --android, the pack is pushed with adb to the Live Scenes app on a connected phone "
                       "(USB debugging on); the app imports it the next time it opens. adb is found via $ADB, "
                       "PATH, $ANDROID_HOME or ~/Android/Sdk.",
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("packdir", metavar="PACKDIR")
    p.add_argument("--android", action="store_true", help="push to a phone over adb instead")

    p = sub.add_parser("catalog", help="write release assets and catalog.json for one or more packs",
                       description="Copy the packs' files into RELEASEDIR as flat release assets "
                       "(<id>-landscape.mp4, <id>-portrait.mp4, <id>-poster.jpg) and write catalog.json with "
                       "URLs relative to it. Upload the folder's contents as GitHub Release assets (or to any web "
                       "server) and point the apps' catalog URL at catalog.json.",
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("packdirs", metavar="PACKDIR", nargs="+")
    p.add_argument("-o", "--output", metavar="RELEASEDIR", required=True)
    p.add_argument("--append", action="store_true",
                   help="keep looks already listed in RELEASEDIR/catalog.json (same ids are replaced)")
    return ap


def main(argv=None):
    ap = build_parser()
    a = ap.parse_args(argv)
    if not a.cmd:
        ap.print_help()
        return 2
    try:
        return {"pack": cmd_pack, "check": cmd_check, "theme": cmd_theme, "add": cmd_add,
                "catalog": cmd_catalog}[a.cmd](a) or 0
    except Fail as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
